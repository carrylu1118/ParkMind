<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campusai.mapper.DocumentMapper">
    
    <resultMap type="Document" id="DocumentResult">
        <result property="id"    column="id"    />
        <result property="title"    column="title"    />
        <result property="url"    column="url"    />
    </resultMap>

    <sql id="selectDocumentVo">
        select id, title, url from document
    </sql>

    <select id="selectDocumentList" parameterType="Document" resultMap="DocumentResult">
        <include refid="selectDocumentVo"/>
        <where>  
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="url != null  and url != ''"> and url like concat('%', #{url}, '%')</if>
        </where>
    </select>
    
    <select id="selectDocumentById" parameterType="String" resultMap="DocumentResult">
        <include refid="selectDocumentVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertDocument" parameterType="Document" useGeneratedKeys="true" keyProperty="id">
        insert into document
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="url != null and url != ''">url,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="url != null and url != ''">#{url},</if>
         </trim>
    </insert>

    <update id="updateDocument" parameterType="Document">
        update document
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="url != null and url != ''">url = #{url},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDocumentById" parameterType="String">
        delete from document where id = #{id}
    </delete>

    <delete id="deleteDocumentByIds" parameterType="String">
        delete from document where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>