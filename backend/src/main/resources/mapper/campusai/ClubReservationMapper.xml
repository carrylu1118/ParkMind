<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campusai.mapper.ClubReservationMapper">
    
    <resultMap type="ClubReservation" id="ClubReservationResult">
        <result property="id"    column="id"    />
        <result property="club"    column="club"    />
        <result property="name"    column="name"    />
        <result property="phone"    column="phone"    />
        <result property="major"    column="major"    />
        <result property="remark"    column="remark"    />
        <result property="userId"    column="user_id"    />
    </resultMap>

    <sql id="selectClubReservationVo">
        select id, club, name, phone, major, remark, user_id from club_reservation
    </sql>

    <select id="selectClubReservationList" parameterType="ClubReservation" resultMap="ClubReservationResult">
        <include refid="selectClubReservationVo"/>
        <where>  
            <if test="club != null  and club != ''"> and club like concat('%', #{club}, '%')</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone like concat('%', #{phone}, '%')</if>
            <if test="major != null  and major != ''"> and major like concat('%', #{major}, '%')</if>
            <if test="userId != null  and userId != ''"> and user_id like concat('%', #{userId}, '%')</if>
        </where>
    </select>
    
    <select id="selectClubReservationById" parameterType="Long" resultMap="ClubReservationResult">
        <include refid="selectClubReservationVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertClubReservation" parameterType="ClubReservation" useGeneratedKeys="true" keyProperty="id">
        insert into club_reservation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="club != null and club != ''">club,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="major != null">major,</if>
            <if test="remark != null">remark,</if>
            <if test="userId != null">user_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="club != null and club != ''">#{club},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="major != null">#{major},</if>
            <if test="remark != null">#{remark},</if>
            <if test="userId != null">#{userId},</if>
         </trim>
    </insert>

    <update id="updateClubReservation" parameterType="ClubReservation">
        update club_reservation
        <trim prefix="SET" suffixOverrides=",">
            <if test="club != null and club != ''">club = #{club},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="major != null">major = #{major},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="userId != null">user_id = #{userId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteClubReservationById" parameterType="Long">
        delete from club_reservation where id = #{id}
    </delete>

    <delete id="deleteClubReservationByIds" parameterType="String">
        delete from club_reservation where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>